{
  "name": "SIRINX Daily Secret Recon Scan",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily 02:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Placeholder: list of owned repos\nreturn [\n  { json: { repo: 'sirinx-co' } },\n  { json: { repo: 'sirinx-os' } },\n  { json: { repo: 'sirinx-skills-kit' } }\n];"
      },
      "id": "list-repos",
      "name": "List Owned Repos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo }}/secret-scanning/alerts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {}
      },
      "id": "github-secret-alerts",
      "name": "GitHub Secret Scanning Alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "credentials": {
        "githubApi": {
          "id": "GITHUB_CREDENTIAL_ID",
          "name": "GitHub (owned assets)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Transform alerts into redacted findings metadata\n// NEVER include the actual secret value\nconst items = $input.all();\nconst findings = [];\nfor (const item of items) {\n  const alerts = Array.isArray(item.json) ? item.json : [item.json];\n  for (const a of alerts) {\n    if (!a || !a.number) continue;\n    findings.push({\n      json: {\n        fingerprint: a.secret_type + '-' + a.number,\n        rule_id: a.secret_type || 'unknown',\n        severity: a.state === 'open' ? 'high' : 'medium',\n        status: 'open',\n        repo: a.repository?.name || 'unknown',\n        file_path: a.locations?.[0]?.details?.path || null,\n        commit_sha: a.locations?.[0]?.details?.commit_sha || null,\n        discovered_at: a.created_at,\n        metadata: { alert_number: a.number, html_url: a.html_url }\n      }\n    });\n  }\n}\nreturn findings;"
      },
      "id": "transform-findings",
      "name": "Transform to Metadata Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "tableId": "secret_findings",
        "options": {}
      },
      "id": "supabase-insert",
      "name": "Insert Finding Metadata",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1200, 300],
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase (SIRINX)"
        }
      }
    }
  ],
  "connections": {
    "Daily 02:00 UTC": {
      "main": [[{"node": "List Owned Repos", "type": "main", "index": 0}]]
    },
    "List Owned Repos": {
      "main": [[{"node": "GitHub Secret Scanning Alerts", "type": "main", "index": 0}]]
    },
    "GitHub Secret Scanning Alerts": {
      "main": [[{"node": "Transform to Metadata Only", "type": "main", "index": 0}]]
    },
    "Transform to Metadata Only": {
      "main": [[{"node": "Insert Finding Metadata", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {"name": "secret-recon"},
    {"name": "ghostclaw"},
    {"name": "defensive"}
  ]
}
